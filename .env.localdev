# Local

# Url to a news YAML of the format in https://github.com/spraakbanken/newsdesk
VITE_NEWS_URL=https://raw.githubusercontent.com/spraakbanken/newsdesk/main/data/karp-s.yaml

# Matomo settings. Both need to be set; unset any of them to disable tracking.
# Url to Matomo backend
VITE_MATOMO_URL=https://spraakbanken.gu.se/stats
# Matomo site id
# VITE_MATOMO_ID=48 # Do not report to the real backend when developing, so comment out this.

# Backend URL
VITE_API_URL=https://spraakbanken4.it.gu.se/karps/v1/

# Auth URL
VITE_API_AUTH=https://sp.spraakbanken.gu.se/auth

# Enable SSL in development
DEV_HTTPS_KEY=../ssl_local_certiciates/_wildcard.spraakbanken.gu.se-key.pem
DEV_HTTPS_CERT=../ssl_local_certiciates/_wildcard.spraakbanken.gu.se.pem